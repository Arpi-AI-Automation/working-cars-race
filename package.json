{
  "name": "working-cars-race",
  "version": "1.0.0",
  "description": "A kids' working-vehicle race, forked from the MIT-licensed pmndrs/racing-game.",
  "keywords": [
    "physics",
    "cannon-es",
    "vehicle",
    "react-three-fiber",
    "kids"
  ],
  "dependencies": {
    "@react-three/cannon": "^6.3.0",
    "@react-three/drei": "^9.4.4",
    "@react-three/fiber": "^8.0.12",
    "inter-ui": "^3.19.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": "^0.139.0",
    "use-asset": "^1.0.4",
    "zustand": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.5",
    "@types/react-dom": "^18.0.1",
    "@types/three": "^0.139.0",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.4.0",
    "eslint-plugin-react": "^7.28.0",
    "husky": "^7.0.4",
    "lint-staged": "^12.3.4",
    "prettier": "^2.5.1",
    "three-stdlib": "^2.9.1",
    "typescript": "^4.9.5",
    "vite": "^5.4.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "eslint": "eslint --cache src",
    "eslint-fix": "eslint --fix --cache src",
    "prettier": "prettier --list-different '**/*.{js,jsx,md,ts,tsx}'",
    "prettier-fix": "prettier --write '**/*.{js,jsx,md,ts,tsx}'",
    "prepare": "husky install"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "type": "module",
  "license": "MIT",
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "*.{js,jsx,ts,tsx,md}": "prettier --write"
  }
}
